# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Authentification API (FIX 1) ────────────────────────────────────────────
# Définissez une valeur aléatoire forte pour activer la protection.
# Laissez vide pour désactiver l'auth (dev local sans Docker uniquement).
# Exemple de génération : python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changez_cette_valeur_en_production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# ⚠️  POSTGRES_PASSWORD : remplacez OBLIGATOIREMENT cette valeur par un mot de
#     passe fort avant tout déploiement (>= 16 caractères aléatoires).
#     Exemple : python -c "import secrets; print(secrets.token_urlsafe(20))"
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez_ce_mot_de_passe_fort_obligatoire
