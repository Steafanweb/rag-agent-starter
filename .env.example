# ── Anthropic ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Sécurité API (Fix 1) ──────────────────────────────────
# Laisse vide pour désactiver l'auth en développement local.
# En production : chaîne aléatoire longue (openssl rand -hex 32)
API_KEY=changeme

# ── PostgreSQL + pgvector ─────────────────────────────────
POSTGRES_HOST=localhost   # 'db' si lancé via Docker Compose
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
